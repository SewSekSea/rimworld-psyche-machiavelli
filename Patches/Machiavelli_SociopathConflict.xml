<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    A colonist is a Machiavellian or a Sociopath, never both: one uses people and still feels,
    the other has stopped feeling for anyone outside a small circle.

    This only applies if the Sociopath mod is actually installed. The conditional checks for its
    trait in the loaded defs first, so with Sociopath absent nothing happens and there is no
    broken cross-reference. Patched in both directions, because either trait may be rolled first.
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TraitDef[defName="SP_Sociopath"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/TraitDef[defName="MAC_Machiavellian"]/conflictingTraits</xpath>
          <value><li>SP_Sociopath</li></value>
        </li>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>/Defs/TraitDef[defName="SP_Sociopath"]/conflictingTraits</xpath>
          <value><li>MAC_Machiavellian</li></value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
