        <li>confided->trusted</li>

        <li>secret->something no one else knows</li>
        <li>secret->a weakness, carefully chosen</li>
        <li>secret->a worry that sounded genuine</li>
        <li>secret->an old shame, possibly invented</li>
        <li>secret->what someone else had said about them</li>
